{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "@playwright/test": [
        "./node_modules/@playwright/test"
      ]
    }
  },
  "include": [
    "../tests/e2e/**/*.ts",
    "playwright.config.ts"
  ]
}