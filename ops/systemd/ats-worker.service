[Unit]
Description=ATS worker (outbox, email, expiry ujian, ekspor, pindai dokumen)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ats
Group=ats
EnvironmentFile=/etc/ats/ats.env
Environment=WORKER_HEALTH_ADDR=127.0.0.1:8081
Environment=WORKER_METRICS_ADDR=127.0.0.1:19081
ExecStart=/opt/ats/current/bin/worker
# Pekerjaan yang sudah diklaim diselesaikan dalam batas lease (60 s) sebelum proses berhenti.
KillSignal=SIGTERM
TimeoutStopSec=75
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/ats
CapabilityBoundingSet=
MemoryMax=1G

[Install]
WantedBy=multi-user.target
