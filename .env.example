# Salin ke .env lalu isi. Jangan commit .env.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/ats_dev?sslmode=disable
DB_MAX_CONNS=20
# Kosongkan bila Redis tidak tersedia: API berjalan dalam mode degraded (cache mati, limiter lokal).
REDIS_URL=
ORG_SLUG=arunika
LOG_LEVEL=info
# Kunci 32 byte base64. Buat dengan: ops/windows/new-keys.ps1. Ketiganya harus berbeda.
SESSION_KEY=
NIK_ENC_KEY=
NIK_ENC_KEY_VERSION=1
NIK_INDEX_KEY=
NIK_INDEX_KEY_VERSION=1
SESSION_IDLE_STAFF=30m
SESSION_IDLE_CANDIDATE=2h
SESSION_ABSOLUTE=12h
# Email: kosongkan SMTP_ADDR untuk menulis .eml ke MAIL_DIR (dev).
MAIL_DIR=.data/mail
# Contoh Gmail: SMTP_ADDR=smtp.gmail.com:587, SMTP_USERNAME=akun@gmail.com, SMTP_PASSWORD=<App Password 16 karakter>.
# SMTP_TLS=starttls (port 587, bawaan) atau implicit (port 465). Kosongkan USERNAME/PASSWORD untuk relay internal.
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
MAIL_FROM="Rekrutmen Arunika <no-reply@arunika.example>"
# WhatsApp: off (bawaan) | file (dev, pesan ditulis ke WHATSAPP_DIR). Kandidat harus menyetujui di Kotak masuk.
# Penyedia produksi (WhatsApp Business Platform) belum disambungkan.
WHATSAPP_MODE=off
WHATSAPP_DIR=.data/whatsapp
OBJECT_DIR=.data/objects
# Pemindai malware untuk dokumen dan CV unggahan. Kosong = dokumen tertahan "Menunggu pemeriksaan file".
# Dev: diisi otomatis oleh new-env.ps1 dengan ops/windows/dev-scan.ps1 (hanya EICAR). Pemindai sungguhan di Windows:
# ops/windows/clamav-start.ps1 lalu "D:\Tools\ClamAV\clamdscan.exe --no-summary --config-file=D:\Tools\ClamAV\clamd.conf"
# (path tanpa spasi). Linux: "clamdscan --no-summary --fdpass".
# Retensi data pelamar diatur di Pengaturan (retention.candidate_months, retention.auto_enabled; bawaan mati).
SCAN_COMMAND=
STRICT_SENSITIVE_LIMITS=true
WORKER_POLL_INTERVAL=1s
WORKER_CONCURRENCY=4
WORKER_HEALTH_ADDR=127.0.0.1:8081
# Hanya untuk seed dev/staging. Tidak ada sandi default.
SEED_PASSWORD=

# ---- Pembaca CV (lihat docs/cv-parsing.md) ----
# Path binary; kosong = dicari di PATH. Tessdata wajib berisi ind, eng, osd (ops\windows\cv-tools.ps1).
CV_PDFINFO=
CV_PDFTOTEXT=
CV_PDFTOPPM=
CV_PDFIMAGES=
CV_TESSERACT=
CV_TESSDATA=
# LibreOffice opsional (.doc lawas, DOCX bergambar). Contoh Windows: C:/Program Files/LibreOffice/program/soffice.com
CV_SOFFICE=
CV_WORK_DIR=
CV_WORKER_CONCURRENCY=2
CV_WORKER_HEALTH_ADDR=127.0.0.1:8082
