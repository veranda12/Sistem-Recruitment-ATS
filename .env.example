# Salin ke .env lalu isi. Jangan commit .env.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/ats_dev?sslmode=disable
DB_MAX_CONNS=20
# Kosongkan bila Redis tidak tersedia: API berjalan dalam mode degraded (cache mati, limiter lokal).
REDIS_URL=
ORG_SLUG=arunika
LOG_LEVEL=info
# Kunci 32 byte base64. Buat dengan: ops/windows/new-keys.ps1. Ketiganya harus berbeda.
SESSION_KEY=
NIK_ENC_KEY=
NIK_ENC_KEY_VERSION=1
NIK_INDEX_KEY=
NIK_INDEX_KEY_VERSION=1
SESSION_IDLE_STAFF=30m
SESSION_IDLE_CANDIDATE=2h
SESSION_ABSOLUTE=12h
# Email: kosongkan SMTP_ADDR untuk menulis .eml ke MAIL_DIR (dev).
MAIL_DIR=.data/mail
SMTP_ADDR=
MAIL_FROM="Rekrutmen Arunika <no-reply@arunika.example>"
OBJECT_DIR=.data/objects
STRICT_SENSITIVE_LIMITS=true
WORKER_POLL_INTERVAL=1s
WORKER_CONCURRENCY=4
WORKER_HEALTH_ADDR=127.0.0.1:8081
# Hanya untuk seed dev/staging. Tidak ada sandi default.
SEED_PASSWORD=
